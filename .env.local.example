GOOGLE_GENAI_API_KEY=your_api_key_here

# Base URLs of the RAG FastAPI services. Document Q&A mode lets you pick which
# vector store to use per upload; only the one(s) you're running need to be set.
RAG_API_URL_PINECONE=http://localhost:8000
RAG_API_URL_QDRANT=http://localhost:8001

# Guardrails: Prompt Guard 2 on Groq + Llama Guard 3 run locally with Ollama
# (`ollama serve`, then `ollama pull llama-guard3:8b`). On by default; if a
# guard can't be reached, requests go through and X-Guardrails is "degraded".
GROQ_API_KEY=
# Optional overrides:
# GUARDRAILS_ENABLED=true
# GUARDRAILS_FAIL_CLOSED=false
# PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# PROMPT_GUARD_THRESHOLD=0.5
# OLLAMA_URL=http://localhost:11434
# LLAMA_GUARD_MODEL=llama-guard3:8b
# LLAMA_GUARD_KEEP_ALIVE=30m
